DWCO_ENVIRONMENT=local
DWCO_GOVERNANCE_PORT=3100
DWCO_API_PORT=8000
DWCO_POSTGRES_PORT=5432
DWCO_REDIS_PORT=6379
DWCO_DATABASE_URL=postgresql+psycopg://dwco:dwco@postgres:5432/dwco
DWCO_REDIS_URL=redis://redis:6379/0
DWCO_JWT_SECRET=replace-with-at-least-32-random-characters
DWCO_ACCESS_TOKEN_MINUTES=15
DWCO_REFRESH_TOKEN_DAYS=30
DWCO_CORS_ORIGINS=["http://localhost:3000"]
DWCO_AUTH_RATE_LIMIT=10
DWCO_MUTATION_RATE_LIMIT=120
DWCO_MESSAGE_SEND_RATE_LIMIT=30
DWCO_REALTIME_TICKET_RATE_LIMIT=10
DWCO_RATE_LIMIT_WINDOW_SECONDS=60
DWCO_REALTIME_TICKET_TTL_SECONDS=60
DWCO_MESSAGE_RETENTION_DAYS=90
# Never put real production secrets in this file.
